# Required: free key from https://twelvedata.com
TWELVEDATA_API_KEY=your_key_here

# Optional (needed for a hosted deploy)
# A long random string used to sign auth tokens.
JWT_SECRET=change-me-to-something-long-and-random
# Your deployed frontend origin, so CORS lets it through (no trailing slash).
FRONTEND_ORIGIN=https://your-frontend.vercel.app
# Seed the demo account on startup so the flagged feed is there for visitors.
SEED_DEMO_ON_START=1
